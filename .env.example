# Local: copie para .env. Produção: Vercel → Settings → Environment Variables.

# Banco Postgres. Na Vercel é preenchida AUTOMATICAMENTE ao conectar o Neon
# (Storage → Create Database → Neon). Localmente, aponte para um Postgres seu.
DATABASE_URL=postgres://usuario:senha@localhost:5432/drap

# Login do painel /admin
ADMIN_EMAIL=voce@empresa.com
ADMIN_PASSWORD=troque-por-uma-senha-forte-de-16+-caracteres

# Segredo para assinar a sessão do painel (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Envio das propostas por e-mail (opcional) — https://resend.com
# Sem estas duas, o painel oferece "Copiar link" e "Abrir no meu e-mail".
RESEND_API_KEY=
MAIL_FROM="DRAP <propostas@seudominio.com.br>"
# Para onde vai o aviso de novo questionário (padrão: e-mail de contato do site)
MAIL_TEAM=
# Endereço público usado nos links dos e-mails (padrão: o domínio da requisição)
SITE_URL=
